# Copy this file to .env and fill in your values. .env is gitignored —
# never commit real Jira credentials.

# Port the Express server (server.js) listens on.
PORT=8000

# Jira Cloud instance base URL, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=

# Jira account email used to generate the API token below.
JIRA_EMAIL=

# Jira API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Custom field ID that holds Acceptance Criteria on your tickets, e.g.
# customfield_10105. Find it via:
#   GET {JIRA_BASE_URL}/rest/api/3/field  (search the response for its name)
# Leave blank to skip fetching Acceptance Criteria.
JIRA_AC_FIELD_ID=

# ---- Test Plan RAG source (Confluence -> MongoDB Atlas Vector Search) ----

# Confluence Cloud instance base URL, e.g. https://yourcompany.atlassian.net
CONFLUENCE_BASE_URL=

# Confluence account email used to generate the API token below (same
# Atlassian account/token page as Jira's).
CONFLUENCE_EMAIL=

# Confluence API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# Page ID of the Test Plan folder's root page - its descendant subtree is
# what gets ingested (not the whole space).
TESTPLAN_ROOT_PAGE_ID=

# MongoDB Atlas connection string.
MONGODB_URI=

# Database and collection holding the embedded Test Plan chunks. Real hybrid
# search (BM25 + vector) - both indexes need to exist on this collection.
DB_NAME=
TESTPLAN_COLLECTION_NAME=test_plans
TESTPLAN_VECTOR_INDEX_NAME=vector_index_test_plans
TESTPLAN_BM25_INDEX_NAME=bm25_search_test_plans

# Mistral AI API key - ALWAYS used for embeddings (ingestion + query-time),
# regardless of CHAT_MODEL_PROVIDER below. Also used for chat/generation
# when CHAT_MODEL_PROVIDER=mistral (the default).
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest

# Which provider answers questions and reformulates follow-ups for Knowledge
# Search (Test Plan / Test Cases). Embeddings are NOT affected by this - they
# stay on Mistral either way (see chatModelProvider.js for why).
# Values: "mistral" (default) or "gemini"
CHAT_MODEL_PROVIDER=mistral

# Only needed when CHAT_MODEL_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
