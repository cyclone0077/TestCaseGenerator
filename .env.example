# Copy this file to .env and fill in your values. .env is gitignored —
# never commit real Jira credentials.

# Port the Express server (server.js) listens on.
PORT=8000

# Jira Cloud instance base URL, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=

# Jira account email used to generate the API token below.
JIRA_EMAIL=

# Jira API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Custom field ID that holds Acceptance Criteria on your tickets, e.g.
# customfield_10105. Find it via:
#   GET {JIRA_BASE_URL}/rest/api/3/field  (search the response for its name)
# Leave blank to skip fetching Acceptance Criteria.
JIRA_AC_FIELD_ID=

# ---- Test Plan RAG source (Confluence -> MongoDB Atlas Vector Search) ----

# Confluence Cloud instance base URL, e.g. https://yourcompany.atlassian.net
CONFLUENCE_BASE_URL=

# Confluence account email used to generate the API token below (same
# Atlassian account/token page as Jira's).
CONFLUENCE_EMAIL=

# Confluence API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# Page ID of the Test Plan folder's root page - its descendant subtree is
# what gets ingested (not the whole space).
TESTPLAN_ROOT_PAGE_ID=

# MongoDB Atlas connection string.
MONGODB_URI=

# Database and collection holding the embedded Test Plan chunks. Real hybrid
# search (BM25 + vector) - both indexes need to exist on this collection.
DB_NAME=
TESTPLAN_COLLECTION_NAME=test_plans
TESTPLAN_VECTOR_INDEX_NAME=vector_index_test_plans
TESTPLAN_BM25_INDEX_NAME=bm25_search_test_plans

# Mistral AI API key - ALWAYS used for embeddings (ingestion + query-time),
# regardless of CHAT_MODEL_PROVIDER below. Also used for chat/generation
# when CHAT_MODEL_PROVIDER=mistral (the default).
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest

# Which provider answers questions and reformulates follow-ups for Knowledge
# Search (Test Plan / Test Cases). Embeddings are NOT affected by this - they
# stay on Mistral either way (see chatModelProvider.js for why).
# Values: "mistral" (default) or "gemini"
CHAT_MODEL_PROVIDER=mistral

# Only needed when CHAT_MODEL_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# ---- Compliance RAG sources: GDPR + EU AI Act + DPDP (gdpr-info.eu /
# artificialintelligenceact.eu / dpdpa.com -> separate MongoDB Atlas
# account, since the Test Plan cluster above is already at its
# vector-index limit) ----

# MongoDB Atlas connection string for a SEPARATE cluster/account than
# MONGODB_URI above. All stay connected at the same time - the app picks
# which one to use per-request based on which Knowledge Search source was
# selected, there's no "only one active" toggle. GDPR/EU AI Act/DPDP live
# in this SAME cluster, just different collections/indexes - NOTE: Atlas
# search-index count is capped per cluster/tier too (M0/free tiers cap out
# fast), so adding a 4th standard may need a tier upgrade or another
# separate cluster, same reasoning as Test Plan's own limit above.
COMPLIANCE_MONGODB_URI=
COMPLIANCE_DB_NAME=

# One embedding per WHOLE legal article/section (not sub-chunked), so
# matches are always citable as a real clause - vector-only search (no
# BM25/hybrid). Defaults match the collection/index names already created
# in Atlas (DPDP's index isn't created yet - ingestion works regardless,
# since writing documents doesn't need a search index, only querying does;
# run `npm run create-compliance-indexes` once there's room for it).
GDPR_COLLECTION_NAME=gdpr
GDPR_VECTOR_INDEX_NAME=gdpr_index
EU_AI_ACT_COLLECTION_NAME=euai
EU_AI_ACT_VECTOR_INDEX_NAME=euai_index
DPDP_COLLECTION_NAME=dpdp
DPDP_VECTOR_INDEX_NAME=dpdp_index

# Each stored clause's vector index has TWO filter fields nested under a
# "metadata" object (metadata.standard / metadata.clauseId) - the native
# mongodb driver is used directly for Compliance ingestion/retrieval
# (complianceIngest.js / complianceClauseRetriever.js) rather than
# LangChain's vector-store abstraction, which would flatten metadata onto
# top-level fields instead and not match this index definition.
COMPLIANCE_VECTOR_DIMENSIONS=1024

# Clauses embedded/upserted per batch during ingestion.
COMPLIANCE_INGEST_BATCH_SIZE=20

# Vector-search candidate count fed into LLM reranking for both GDPR and EU
# AI Act. Matches are ranked per whole article, not per sub-clause - a
# sub-clause-specific story (e.g. Art. 5(1)(e)) surfaces via its parent
# article, which may need a higher value to appear in the candidate set.
COMPLIANCE_TOP_K=10
